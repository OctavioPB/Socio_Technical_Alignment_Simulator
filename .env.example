# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_dev

# ─── Simulation ──────────────────────────────────────────────────────────────
# Graphs above this node count use Neo4j GDS instead of NetworkX
SIMULATION_GDS_THRESHOLD=200

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_PASSWORD=admin
# Slack incoming webhook for DAG failure and topology-change alerts
SLACK_ALERT_WEBHOOK_URL=
# Kafka health check thresholds (override defaults in stas_telemetry_health)
STAS_LAG_THRESHOLD=1000
STAS_DLQ_THRESHOLD=10

# ─── Telemetry webhook secrets ───────────────────────────────────────────────
# Leave blank in dev to skip signature validation
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
JIRA_WEBHOOK_SECRET=

# ─── Telemetry consumer ───────────────────────────────────────────────────────
METRICS_PORT=9090
TELEMETRY_WINDOW_DAYS=90

# ─── Clerk (Auth) ────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Auth hardening (Sprint 9) ───────────────────────────────────────────────
# Clerk JWKS URL — set in production to enable JWT verification on the API.
# Format: https://<your-clerk-domain>/.well-known/jwks.json
# Leave blank in dev to bypass JWT validation.
CLERK_JWKS_URL=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Never commit this value. Injected via Vault in production.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_SIM_PER_HOUR=100
RATE_LIMIT_EXTRACT_PER_HOUR=20

# ─── Observability (Sprint 9) ────────────────────────────────────────────────
LOG_LEVEL=INFO
# Use "text" for local dev (coloured), "json" for production (structured)
LOG_FORMAT=text
METRICS_ENABLED=true
ENVIRONMENT=development
# Sentry DSN — leave blank to disable. Never commit real DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Grafana (Docker Compose dev)
GRAFANA_ADMIN_PASSWORD=admin

# ─── HashiCorp Vault (production only) ───────────────────────────────────────
# Leave blank in dev — secrets come from .env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PATH=secret/data/stas
